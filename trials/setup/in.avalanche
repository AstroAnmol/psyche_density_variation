### Avalanche particles psyche gravity before settling them in new gravity###

### Initialization
# Preliminaries
units           si
atom_style      hybrid granular dipole
atom_modify     sort 10000 0

# boundaries
boundary        f f fs

newton          off
hard_particles  yes
communicate     single vel yes

# the product of the processors must equal P, the number of processors used when running the file: mpirun -np 4 ...
processors      4 3 3
# running on 36 processors on dustiest

#############################
read_restart ./restart_setup_1_filled.static

### VARIABLES DEFINITION

# Dimensions of the box
variable        dom_length equal 3 # 3 meters
variable        dom_width  equal 1 # 1 meter
variable        dom_height equal 1.5 # 1.5 meters
variable        mid_wall   equal 1.5 # 1.5 meters


# variable        dom_dia equal qrt(${dom_length}*${dom_length}+${dom_width}*${dom_width}+${dom_height}*${dom_height})

# Particle diameter range
variable        particle_dia equal 0.05 # 5 cm
variable        particle_radius equal ${particle_dia}/2

# Neighbor skin distance (fixed for all simulations)
variable        skin_dist equal  0.15 #meters 

################################
# Material properties
################################

# METALLIC REGOLITH (KAMACITE, Fe-Ni ALLOY)
variable        density_kamacite equal 7870 # kg/m3 # Tanton et al 2020
variable        youngsM_kamacite equal 150.96e7 # N/m^2 # Tang 2023
variable        poissons_kamacite equal 0.17 # Tang 2023
variable        mag_susc_kamacite equal 20.0 # Assumed

# METALLIC REGOLITH (TROILITE, FeS)
variable        density_troilite equal 4900 # kg/m3 # Tanton et al 2020
variable        youngsM_troilite equal 6.0e9 # N/m^2 # Tang 2023
variable        poissons_troilite equal 0.25 # Tang 2023
variable        mag_susc_troilite equal 5.0 # Assumed

# ROCKY ASTEROID REGOLITH (Frizzell et al 2025)
variable        density_rocky equal 2500 # kg/m3
variable        youngsM_rocky equal 5e6 # N/m^2
variable        poissons_rocky equal 0.20
variable        mag_susc_rocky equal 0.0 # NOT MAGNETIC

# Acrylic (Sikka et al 2026)
variable        density_acrylic equal 1250 # kg/m3
variable        youngsM_acrylic equal 3e7 # N/m^2
variable        poissons_acrylic equal 0.4
variable        mag_susc_acrylic equal 0.0 # NOT MAGNETIC

################################
# Choosing material for particles, walls and floor
# Change these variables to change material types
################################

# Particle material type 1
# Using Kamacite for high magnetic susceptibility case
variable        density_particle1 equal ${density_kamacite}
variable        youngsM_particle1 equal ${youngsM_kamacite}
variable        poissons_particle1 equal ${poissons_kamacite}
variable        magnetic_susc_particle1 equal ${mag_susc_kamacite}

# Particle material type 2
# Using Troilite for mixture
variable        density_particle2 equal ${density_troilite}
variable        youngsM_particle2 equal ${youngsM_troilite}
variable        poissons_particle2 equal ${poissons_troilite}
variable        magnetic_susc_particle2 equal ${mag_susc_troilite}

# Particle material type 3
# Using Rocky material for mixture
variable        density_particle3 equal ${density_rocky}
variable        youngsM_particle3 equal ${youngsM_rocky}
variable        poissons_particle3 equal ${poissons_rocky}
variable        magnetic_susc_particle3 equal ${mag_susc_rocky}

# Floor material type
# Same as particles type 1 - Kamacite
variable        density_floor equal ${density_kamacite}
variable        youngsM_floor equal ${youngsM_kamacite}
variable        poissons_floor equal ${poissons_kamacite}
variable        magnetic_susc_floor equal ${mag_susc_kamacite}

# Wall material type
# Using Acrylic for walls
variable        density_wall equal ${density_acrylic}
variable        youngsM_wall equal ${youngsM_acrylic}
variable        poissons_wall equal ${poissons_acrylic}
variable        magnetic_susc_wall equal ${mag_susc_acrylic}
# ################################

# KEEPING FRICTION, RESTITUTION, COHESION CONSTANT FOR ALL SIMULATIONS
# BASED ON FRIZZELL ET AL 2025 and SIKKA ET AL 2026

# Friction Properties
variable        friction_coeff_11 equal 1.0 # metallic1-metallic1
variable        friction_coeff_12 equal 1.0 # metallic1-metallic2
variable        friction_coeff_13 equal 1.0 # metallic1-rocky
variable        friction_coeff_14 equal 1.0 # metallic1-floor
variable        friction_coeff_15 equal 0.1 # metallic1-wall

variable        friction_coeff_21 equal ${friction_coeff_12}
variable        friction_coeff_22 equal 1.0 # metallic2-metallic2
variable        friction_coeff_23 equal 1.0 # metallic2-rocky
variable        friction_coeff_24 equal 1.0 # metallic2-floor
variable        friction_coeff_25 equal 0.1 # metallic2-wall

variable        friction_coeff_31 equal ${friction_coeff_13}
variable        friction_coeff_32 equal ${friction_coeff_23}
variable        friction_coeff_33 equal 1.0 # rocky-rocky 
variable        friction_coeff_34 equal 1.0 # rocky-floor 
variable        friction_coeff_35 equal 0.1 # rocky-wall 

variable        friction_coeff_41 equal ${friction_coeff_14}
variable        friction_coeff_42 equal ${friction_coeff_24}
variable        friction_coeff_43 equal ${friction_coeff_34}
variable        friction_coeff_44 equal 0.1 # floor-floor (doesn't interact)
variable        friction_coeff_45 equal 0.1 # floor-wall (doesn't interact)

variable        friction_coeff_51 equal ${friction_coeff_15}
variable        friction_coeff_52 equal ${friction_coeff_25}
variable        friction_coeff_53 equal ${friction_coeff_35}
variable        friction_coeff_54 equal ${friction_coeff_45}
variable        friction_coeff_55 equal 0.1 # wall-wall (doesn't interact) 

# Rolling Friction Properties

# Rolling friction coefficient
variable        rolling_coeff_11 equal 0.7 # metallic1-metallic1
variable        rolling_coeff_12 equal 0.7 # metallic1-metallic2
variable        rolling_coeff_13 equal 0.7 # metallic1-rocky
variable        rolling_coeff_14 equal 0.7 # metallic1-floor
variable        rolling_coeff_15 equal 0.01 # metallic1-wall

variable        rolling_coeff_21 equal ${rolling_coeff_12}
variable        rolling_coeff_22 equal 0.7 # metallic2-metallic2
variable        rolling_coeff_23 equal 0.7 # metallic2-rocky
variable        rolling_coeff_24 equal 0.7 # metallic2-floor
variable        rolling_coeff_25 equal 0.01 # metallic2-wall

variable        rolling_coeff_31 equal ${rolling_coeff_13}
variable        rolling_coeff_32 equal ${rolling_coeff_23}
variable        rolling_coeff_33 equal 0.7 # rocky-rocky 
variable        rolling_coeff_34 equal 0.7 # rocky-floor 
variable        rolling_coeff_35 equal 0.01 # rocky-wall

variable        rolling_coeff_41 equal ${rolling_coeff_14}
variable        rolling_coeff_42 equal ${rolling_coeff_24}
variable        rolling_coeff_43 equal ${rolling_coeff_34}
variable        rolling_coeff_44 equal 0.01 # floor-floor (doesn't interact)
variable        rolling_coeff_45 equal 0.01 # floor-wall (doesn't interact)

variable        rolling_coeff_51 equal ${rolling_coeff_15}
variable        rolling_coeff_52 equal ${rolling_coeff_25}
variable        rolling_coeff_53 equal ${rolling_coeff_35}
variable        rolling_coeff_54 equal ${rolling_coeff_45}
variable        rolling_coeff_55 equal 0.01 # wall-wall (doesn't interact)

# Rolling Damp
variable        rolling_damp_11 equal 2.0 # metallic1-metallic1
variable        rolling_damp_12 equal 2.0 # metallic1-metallic2
variable        rolling_damp_13 equal 2.0 # metallic1-rocky
variable        rolling_damp_14 equal 2.0 # metallic1-floor
variable        rolling_damp_15 equal 0.01 # metallic1-wall

variable        rolling_damp_21 equal ${rolling_damp_12}
variable        rolling_damp_22 equal 2.0 # metallic2-metallic2 
variable        rolling_damp_23 equal 2.0 # metallic2-rocky 
variable        rolling_damp_24 equal 2.0 # metallic2-floor
variable        rolling_damp_25 equal 0.01 # metallic2-wall

variable        rolling_damp_31 equal ${rolling_damp_13}
variable        rolling_damp_32 equal ${rolling_damp_23}
variable        rolling_damp_33 equal 2.0 # rocky-rocky 
variable        rolling_damp_34 equal 2.0 # rocky-floor 
variable        rolling_damp_35 equal 0.01 # rocky-wall

variable        rolling_damp_41 equal ${rolling_damp_14}
variable        rolling_damp_42 equal ${rolling_damp_24}
variable        rolling_damp_43 equal ${rolling_damp_34}
variable        rolling_damp_44 equal 0.01 # floor-floor (doesn't interact)
variable        rolling_damp_45 equal 0.01 # floor-wall (doesn't interact)

variable        rolling_damp_51 equal ${rolling_damp_15}
variable        rolling_damp_52 equal ${rolling_damp_25}
variable        rolling_damp_53 equal ${rolling_damp_35}
variable        rolling_damp_54 equal ${rolling_damp_45}
variable        rolling_damp_55 equal 0.01 # wall-wall (doesn't interact)

# Coefficient of Restitution
variable        coeff_rest_11 equal 0.85 # metallic1-metallic1
variable        coeff_rest_12 equal 0.85  # metallic1-metallic2
variable        coeff_rest_13 equal 0.85  # metallic1-rocky
variable        coeff_rest_14 equal 0.85  # metallic1-floor
variable        coeff_rest_15 equal 0.4  # metallic1-wall

variable        coeff_rest_21 equal ${coeff_rest_12}
variable        coeff_rest_22 equal 0.85 # metallic2-metallic2 
variable        coeff_rest_23 equal 0.85 # metallic2-rocky 
variable        coeff_rest_24 equal 0.85 # metallic2-floor
variable        coeff_rest_25 equal 0.4 # metallic2-wall

variable        coeff_rest_31 equal ${coeff_rest_13}
variable        coeff_rest_32 equal ${coeff_rest_23}
variable        coeff_rest_33 equal 0.85 # rocky-rocky 
variable        coeff_rest_34 equal 0.85 # rocky-floor 
variable        coeff_rest_35 equal 0.4 # rocky-wall

variable        coeff_rest_41 equal ${coeff_rest_14}
variable        coeff_rest_42 equal ${coeff_rest_24}
variable        coeff_rest_43 equal ${coeff_rest_34}
variable        coeff_rest_44 equal 0.85 # floor-floor (doesn't interact)
variable        coeff_rest_45 equal 0.4 # floor-wall (doesn't interact)

variable        coeff_rest_51 equal ${coeff_rest_15}
variable        coeff_rest_52 equal ${coeff_rest_25}
variable        coeff_rest_53 equal ${coeff_rest_35}
variable        coeff_rest_54 equal ${coeff_rest_45}
variable        coeff_rest_55 equal 0.4 # wall-wall (doesn't interact)

# Cohesion Energy Density (J/m3)
variable        cohesion_energy equal 1e3
variable        cohesion_energy_11 equal ${cohesion_energy} # metallic1-metallic1
variable        cohesion_energy_12 equal ${cohesion_energy} # metallic1-metallic2
variable        cohesion_energy_13 equal ${cohesion_energy} # metallic1-rocky
variable        cohesion_energy_14 equal ${cohesion_energy} # metallic1-floor 
variable        cohesion_energy_15 equal 0.0 # metallic1-wall

variable        cohesion_energy_21 equal ${cohesion_energy_12}
variable        cohesion_energy_22 equal ${cohesion_energy} # metallic2-metallic2 
variable        cohesion_energy_23 equal ${cohesion_energy} # metallic2-rocky 
variable        cohesion_energy_24 equal ${cohesion_energy} # metallic2-floor
variable        cohesion_energy_25 equal 0.0 # metallic2-wall 

variable        cohesion_energy_31 equal ${cohesion_energy_13}
variable        cohesion_energy_32 equal ${cohesion_energy_23}
variable        cohesion_energy_33 equal ${cohesion_energy} # rocky-rocky 
variable        cohesion_energy_34 equal ${cohesion_energy} # rocky-floor 
variable        cohesion_energy_35 equal 0.0 # rocky-wall

variable        cohesion_energy_41 equal ${cohesion_energy_14}
variable        cohesion_energy_42 equal ${cohesion_energy_24}
variable        cohesion_energy_43 equal ${cohesion_energy_34}
variable        cohesion_energy_44 equal 0.0 # floor-floor (doesn't interact)
variable        cohesion_energy_45 equal 0.0 # floor-wall (doesn't interact)

variable        cohesion_energy_51 equal ${cohesion_energy_15}
variable        cohesion_energy_52 equal ${cohesion_energy_25}
variable        cohesion_energy_53 equal ${cohesion_energy_35}
variable        cohesion_energy_54 equal ${cohesion_energy_45}
variable        cohesion_energy_55 equal 0.0 # wall-wall (doesn't interact)

# Force properties
variable        earth_g equal 9.82 #m/s^2
variable        psyche_g equal 0.13 #m/s^2

# Time steps
variable        dt equal 2e-6 # s every 2 microseconds
variable        dumptime equal 1e-3 # s every millisecond
variable        dumpstep equal ${dumptime}/${dt}
variable        thermostep equal ${dumpstep}
variable        checktimestep equal 1e-3/${dt} 
variable        neighstep equal 1e-2/${dt} # create a new neigh list 

# MAGNETIC TIME NEEDED IF MAGNETIC FORCES ARE USED
# variable        magtime equal 1e-3 
# variable        magstep equal ${magtime}/${dt} # calculate new magnetic forces every magstep steps

# Variables for run times
variable        half_second_steps equal 0.5/${dt} # number of steps for 0.5 seconds time
variable        one_second_steps equal 1/${dt} # number of steps for 1.0 seconds time
variable        two_second_steps equal 2/${dt} # number of steps for 2.0 seconds time
variable        0_1_second_steps equal 0.1/${dt}

## DEFINITING SIM PROPERTIES
# Neighbor skin style - atom pairs within a neighbor cutoff distance = force cutoff + skin distance, styele = bin
neighbor        ${skin_dist} bin
# neigh_modify delay 0, this is the default, rebuild neighbor list every timestep
neigh_modify    delay 0 check yes

fix             m1 all property/global youngsModulus peratomtype ${youngsM_particle1} ${youngsM_particle2} ${youngsM_particle3} ${youngsM_floor} ${youngsM_wall} 
fix             m2 all property/global poissonsRatio peratomtype ${poissons_particle1} ${poissons_particle2} ${poissons_particle3} ${poissons_floor} ${poissons_wall} 
fix             m3 all property/global coefficientRestitution peratomtypepair 5 ${coeff_rest_11} ${coeff_rest_12} ${coeff_rest_13} ${coeff_rest_14} ${coeff_rest_15} &
                                        ${coeff_rest_21} ${coeff_rest_22} ${coeff_rest_23} ${coeff_rest_24} ${coeff_rest_25} ${coeff_rest_31} ${coeff_rest_32} &
                                        ${coeff_rest_33} ${coeff_rest_34} ${coeff_rest_35} ${coeff_rest_41} ${coeff_rest_42} ${coeff_rest_43} ${coeff_rest_44} ${coeff_rest_45} &
                                        ${coeff_rest_51} ${coeff_rest_52} ${coeff_rest_53} ${coeff_rest_54} ${coeff_rest_55}

fix             m4 all property/global coefficientFriction peratomtypepair 5 ${friction_coeff_11} ${friction_coeff_12} ${friction_coeff_13} ${friction_coeff_14} ${friction_coeff_15} &
                                        ${friction_coeff_21} ${friction_coeff_22} ${friction_coeff_23} ${friction_coeff_24} ${friction_coeff_25} ${friction_coeff_31} ${friction_coeff_32} &
                                        ${friction_coeff_33} ${friction_coeff_34} ${friction_coeff_35} ${friction_coeff_41} ${friction_coeff_42} ${friction_coeff_43} ${friction_coeff_44} ${friction_coeff_45} &
                                        ${friction_coeff_51} ${friction_coeff_52} ${friction_coeff_53} ${friction_coeff_54} ${friction_coeff_55}

fix             m5 all property/global coefficientRollingFriction peratomtypepair 5 ${rolling_coeff_11} ${rolling_coeff_12} ${rolling_coeff_13} ${rolling_coeff_14} ${rolling_coeff_15} &
                                        ${rolling_coeff_21} ${rolling_coeff_22} ${rolling_coeff_23} ${rolling_coeff_24} ${rolling_coeff_25} ${rolling_coeff_31} ${rolling_coeff_32} &
                                        ${rolling_coeff_33} ${rolling_coeff_34} ${rolling_coeff_35} ${rolling_coeff_41} ${rolling_coeff_42} ${rolling_coeff_43} ${rolling_coeff_44} ${rolling_coeff_45} &
                                        ${rolling_coeff_51} ${rolling_coeff_52} ${rolling_coeff_53} ${rolling_coeff_54} ${rolling_coeff_55}

fix             m6 all property/global coefficientRollingViscousDamping peratomtypepair 5 ${rolling_damp_11} ${rolling_damp_12} ${rolling_damp_13} ${rolling_damp_14} ${rolling_damp_15} &
                                        ${rolling_damp_21} ${rolling_damp_22} ${rolling_damp_23} ${rolling_damp_24} ${rolling_damp_25} ${rolling_damp_31} ${rolling_damp_32} &
                                        ${rolling_damp_33} ${rolling_damp_34} ${rolling_damp_35} ${rolling_damp_41} ${rolling_damp_42} ${rolling_damp_43} ${rolling_damp_44} ${rolling_damp_45} &
                                        ${rolling_damp_51} ${rolling_damp_52} ${rolling_damp_53} ${rolling_damp_54} ${rolling_damp_55}

fix             m8 all property/global cohesionEnergyDensity peratomtypepair 5 ${cohesion_energy_11} ${cohesion_energy_12} ${cohesion_energy_13} ${cohesion_energy_14} ${cohesion_energy_15} &
                                    ${cohesion_energy_21} ${cohesion_energy_22} ${cohesion_energy_23} ${cohesion_energy_24} ${cohesion_energy_25} ${cohesion_energy_31} ${cohesion_energy_32} &
                                    ${cohesion_energy_33} ${cohesion_energy_34} ${cohesion_energy_35} ${cohesion_energy_41} ${cohesion_energy_42} ${cohesion_energy_43} ${cohesion_energy_44} ${cohesion_energy_45} &
                                    ${cohesion_energy_51} ${cohesion_energy_52} ${cohesion_energy_53} ${cohesion_energy_54} ${cohesion_energy_55}

# fix             m9 all property/global magneticSusceptibility peratomtype ${magnetic_susc_particle1}  ${magnetic_susc_particle2} ${magnetic_susc_floor} ${magnetic_susc_wall}

## Pair style
pair_style      gran model hertz tangential history cohesion sjkr rolling_friction epsd torsionTorque on
pair_coeff	    * *  # the asterisks set force field coeefficients for all atom types, but then no other args? ASK TOM

## box walls - define simulation 	
fix		        wall_z1 all wall/gran model hertz tangential history primitive type 5 zplane 0.0        #floor
fix		        wall_z2 all wall/gran model hertz tangential history primitive type 5 zplane ${dom_height}
fix             wall_x1 all wall/gran model hertz tangential history primitive type 5 xplane 0.0            
# fix             wall_x2 all wall/gran model hertz tangential history primitive type 4 xplane ${dom_length}  
fix             wall_y1 all wall/gran model hertz tangential history primitive type 5 yplane 0.0            
fix             wall_y2 all wall/gran model hertz tangential history primitive type 5 yplane ${dom_width}

## wall in centre which is removed to simulate mass wasting
fix             wall_center all wall/gran model hertz tangential history primitive type 5 xplane ${mid_wall}

# Gravity
# setting the particle assembly in earth gravity
fix             grav all gravity ${psyche_g} vector 0.0 0.0 -1.0 # negative z

# Time step
timestep        ${dt} #seconds 

## Thermo settings
# thermo style custom says what thermo data we want printed at each thermo timestep - timestep, num atoms, kinetic energy, volume
thermo_style 	custom step atoms ke vol
# thermo output every therostep timesteps
thermo		    ${thermostep}
# LIGGGHTS will ignore last particles and will not normalize against num atoms
thermo_modify	lost ignore norm no

## Particle insertion
variable        2_5_particle_rad equal ${particle_radius}*2.5
variable        number_of_particles equal 10000

variable        fill_height equal 1.2 # meter

### Detailed settings
# apply nve integration to all particles that are inserted as single particles
fix		        integr prtcls nve/sphere update dipole


# Check time step and initialize dump file
fix             ctg all check/timestep/gran ${checktimestep} 0.01 0.01
# run             1
# unfix           ctg

# Create imaging information
dump            dmp all custom ${dumpstep} results/dump*.post id type x y z vx vy vz radius fx fy fz mass


# ensure particles are static 
velocity       all set 0. 0. 0.

## freeze
fix             floor_freeze pts_floor freeze

run           0

# particle ground
region          floor block ${mid_wall} EDGE EDGE EDGE ${particle_radius} ${2_5_particle_rad}
lattice         hcp ${particle_dia}
create_atoms    4 region floor
group           pts_floor region floor
set             group pts_floor density ${density_floor} diameter ${particle_dia}

unfix           floor_freeze
fix             floor_freeze pts_floor freeze

# Let particles settle in new gravity
print           "INFO: Letting particles settle for ${one_second_steps} steps (1 second)."
run            ${one_second_steps}   #1 sec

print           "INFO: Settling run complete."
write_restart   restart_setup_1_settled_1s.static
print           "INFO: Restart file 'restart_setup_1_settled_1s.static' written."

print           "INFO: Letting particles settle for ${one_second_steps} steps (1 second)."
run            ${one_second_steps}   #1 sec

print           "INFO: Settling run complete."
write_restart   restart_setup_1_settled_2s.static
print           "INFO: Restart file 'restart_setup_1_settled_2s.static' written."

print           "INFO: Letting particles settle for ${one_second_steps} steps (1 second)."
run            ${one_second_steps}   #1 sec

print           "INFO: Settling run complete."
write_restart   restart_setup_1_settled_3s.static
print           "INFO: Restart file 'restart_setup_1_settled_3s.static' written."


# Increase the domain:
fix             wall_x2 all wall/gran model hertz tangential history primitive type 4 xplane ${dom_length}  

change_box      all boundary f f fs x final 0 ${dom_length} # 280 mm

# particle ground
region          floor_full block ${mid_wall} EDGE EDGE EDGE ${particle_radius} ${2_5_particle_rad}
lattice         hcp ${particle_dia}
create_atoms    4 region floor_full
group           pts_floor_full region floor_full
set             group pts_floor_full density ${density_floor} diameter ${particle_dia}

unfix           floor_freeze
fix             floor_freeze pts_floor_full freeze

# Pull the stopper
unfix           wall_center
print           "INFO: Center wall unfix_ed. Stopper pulled."


# --- Avalanche Phase ---
print           "INFO: Starting avalanching simulation for ${two_second_steps} steps (2 seconds)."


# RUN FOR 2.0 SECONDS
run             ${two_second_steps} 
                # "write_restart restart_mag_drop.static"

print           "INFO: Avalanching run for 2 seconds complete."

write_restart   restart_setup_1_2s.static
print           "INFO: Restart file 'restart_setup_1_2s.static' written."

# RUN FOR 2.0 SECONDS
run             ${two_second_steps} 

print           "INFO: Avalanching run for 2 seconds complete."

write_restart   restart_setup_1_4s.static
print           "INFO: Restart file 'restart_setup_1_4s.static' written."

# RUN FOR 2.0 SECONDS
run             ${two_second_steps} 

print           "INFO: Avalanching run for 2 seconds complete."

write_restart   restart_setup_1_6s.static
print           "INFO: Restart file 'restart_setup_1_6s.static' written."

# RUN FOR 2.0 SECONDS
run             ${two_second_steps} 

print           "INFO: Avalanching run for 2 seconds complete."

write_restart   restart_setup_1_8s.static
print           "INFO: Restart file 'restart_setup_1_8s.static' written."

# RUN FOR 2.0 SECONDS
run             ${two_second_steps} 

print           "INFO: Avalanching run for 2 seconds complete."

write_restart   restart_setup_1_10s.static
print           "INFO: Restart file 'restart_setup_1_10s.static' written."

print           "INFO: Main Avalanche Phase Completed."

print           "INFO: Simulation ended."